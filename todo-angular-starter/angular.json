{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "ng-training-assignment-todo": {
      "projectType": "application",
      "root": "src",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "options": {
            "outputPath": "dist/ng-training-assignment-todo",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "node_modules/@salesforce-ux/design-system/assets/styles/salesforce-lightning-design-system.min.css",
              "src/styles.scss"
            ]
          }
        },
        "serve": {
          "options": {
            "browserTarget": "ng-training-assignment-todo:build"
          }
        }
      }
    }
  },
  "defaultProject": "ng-training-assignment-todo"
}